ARG_ENABLE("mdparser", "Enable mdparser (CommonMark + GFM) support", "no");
ARG_ENABLE("mdparser-dev", "Upgrade wrapper warnings to /WX (development builds)", "no");

if (PHP_MDPARSER != "no") {
    if (PHP_VERSION < 8 || (PHP_VERSION == 8 && PHP_MINOR_VERSION < 2)) {
        ERROR("mdparser requires PHP 8.2 or newer");
    }

    var md4c_src_dir = "vendor/md4c";

    ADD_FLAG("CFLAGS_MDPARSER", "/I" + configure_module_dirname + "\\" + md4c_src_dir);
    if (PHP_MDPARSER_DEV == "yes") {
        ADD_FLAG("CFLAGS_MDPARSER", "/WX");
    }

    // md4c (https://github.com/mity/md4c, MIT): single-file push parser plus
    // its bundled HTML entity table. entity.c is needed for named-entity
    // decoding; we use our own callback renderer (md4c-html.c is vendored but
    // not compiled). Keep in sync with config.m4.
    var md4c_sources = "entity.c";

    var wrapper_sources = "mdparser.c mdparser_parser.c mdparser_options.c " +
        "mdparser_exception.c mdparser_md4c_html.c mdparser_md4c_ast.c " +
        "mdparser_md4c_xml.c mdparser_md4c_util.c mdparser_md4c_vendor.c";

    EXTENSION("mdparser", wrapper_sources);
    ADD_SOURCES(configure_module_dirname + "\\" + md4c_src_dir, md4c_sources, "mdparser");
}
